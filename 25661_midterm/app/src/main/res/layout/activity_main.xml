<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AUCA University App"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/tvLaunchCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="App launched: 0 times" />

    <Button
        android:id="@+id/btnStudentManagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Student Management"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCourseManagement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Course Management"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEnrollments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enrollments"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnExportCSV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Export to CSV" />

</LinearLayout>