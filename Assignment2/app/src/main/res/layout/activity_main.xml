<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnManageFaculties"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Faculties"
        android:layout_marginBottom="16dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnManageStudents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Students"
        android:layout_marginBottom="16dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnManageCourses"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Courses"
        android:layout_marginBottom="16dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnManageEnrollments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Enrollments"
        android:textSize="16sp" />

</LinearLayout>