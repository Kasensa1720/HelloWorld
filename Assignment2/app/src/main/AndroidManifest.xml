<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        tools:targetApi="31">

        <!-- Main Dashboard Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Faculty Management Activities -->
        <activity
            android:name=".FacultyListActivity"
            android:label="Faculties"
            android:exported="false" />
        <activity
            android:name=".AddFacultyActivity"
            android:label="Add Faculty"
            android:exported="false" />
        <activity
            android:name=".FacultyDetailActivity"
            android:label="Faculty Details"
            android:exported="false" />

        <!-- Student Management Activities -->
        <activity
            android:name=".StudentListActivity"
            android:label="Students"
            android:exported="false" />
        <activity
            android:name=".AddStudentActivity"
            android:label="Add Student"
            android:exported="false" />
        <activity
            android:name=".StudentDetailActivity"
            android:label="Student Details"
            android:exported="false" />

        <!-- Course Management Activities -->
        <activity
            android:name=".CourseListActivity"
            android:label="Courses"
            android:exported="false" />
        <activity
            android:name=".AddCourseActivity"
            android:label="Add Course"
            android:exported="false" />
        <activity
            android:name=".CourseDetailActivity"
            android:label="Course Details"
            android:exported="false" />

        <!-- Enrollment Management Activity -->
        <activity
            android:name=".EnrollmentActivity"
            android:label="Enrollments"
            android:exported="false" />

        <activity
            android:name=".FacultyFormActivity"
            android:label="Faculty Form"
            android:exported="false" />

    </application>

</manifest>